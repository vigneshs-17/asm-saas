# Database configuration
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me
DATABASE_URL=postgresql+psycopg://change-me:change-me@db:5432/change-me

# For running database tests locally (must point to a database name ending with _test)
# TEST_DATABASE_URL=postgresql+psycopg://change-me:change-me@localhost:5432/asm_test

# SMTP configuration for email alerts
# Leave SMTP_HOST empty to disable alert delivery (default)
# To enable local testing with Mailpit: set SMTP_HOST=mailpit and run `docker compose --profile dev up -d`
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=alerts@asm.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
